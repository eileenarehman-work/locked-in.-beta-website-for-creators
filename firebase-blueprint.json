{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document containing account and reputation info",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique user ID matching auth UID or generated ID",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 128
        },
        "googleId": {
          "type": "string",
          "description": "Google Auth identifier",
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the maker",
          "maxLength": 80
        },
        "handle": {
          "type": "string",
          "description": "Unique username handle without @",
          "maxLength": 50
        },
        "avatarUrl": {
          "type": "string",
          "description": "Avatar image URL or SVG data URL",
          "maxLength": 50000
        },
        "bio": {
          "type": "string",
          "description": "Short bio or tagline",
          "maxLength": 500
        },
        "age": {
          "type": "number",
          "description": "Age of the creator (13+)"
        },
        "reputationScore": {
          "type": "number",
          "description": "Maker reputation score"
        },
        "trustTier": {
          "type": "string",
          "description": "Verification tier of the creator",
          "maxLength": 30
        },
        "interestTags": {
          "type": "array",
          "description": "Tags of builder interests"
        },
        "isEmailVerified": {
          "type": "boolean",
          "description": "Whether email is verified"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of account creation",
          "maxLength": 40
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of account update",
          "maxLength": 40
        }
      },
      "required": ["id", "email", "handle", "displayName"]
    },
    "Project": {
      "title": "Project",
      "description": "Creator project build or hardware/software showcase",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique project identifier",
          "maxLength": 128
        },
        "authorId": {
          "type": "string",
          "description": "User ID of the author",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Title of the project build",
          "maxLength": 150
        },
        "slug": {
          "type": "string",
          "description": "URL slug for the project",
          "maxLength": 160
        },
        "tagline": {
          "type": "string",
          "description": "Short summary tagline",
          "maxLength": 280
        },
        "contentMarkdown": {
          "type": "string",
          "description": "Detailed project description markdown",
          "maxLength": 20000
        },
        "mediaUrls": {
          "type": "array",
          "description": "URLs to project images or diagrams"
        },
        "viewsCount": {
          "type": "number",
          "description": "Number of times viewed"
        },
        "likesCount": {
          "type": "number",
          "description": "Number of likes"
        },
        "tags": {
          "type": "array",
          "description": "Category tags"
        },
        "category": {
          "type": "string",
          "description": "Primary build category",
          "maxLength": 50
        },
        "status": {
          "type": "string",
          "description": "Publication status",
          "maxLength": 30
        },
        "openForCollab": {
          "type": "boolean",
          "description": "Whether project welcomes collaborators"
        },
        "hidden": {
          "type": "boolean",
          "description": "Whether project is hidden from public feed"
        },
        "demoUrl": {
          "type": "string",
          "description": "Live demo URL",
          "maxLength": 300
        },
        "repoUrl": {
          "type": "string",
          "description": "Repository URL",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "description": "Creation ISO timestamp",
          "maxLength": 40
        },
        "updatedAt": {
          "type": "string",
          "description": "Update ISO timestamp",
          "maxLength": 40
        }
      },
      "required": ["id", "authorId", "title"]
    },
    "Review": {
      "title": "Review",
      "description": "Constructive maker review and rubric score",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique review ID",
          "maxLength": 128
        },
        "projectId": {
          "type": "string",
          "description": "Target project ID",
          "maxLength": 128
        },
        "reviewerId": {
          "type": "string",
          "description": "Author user ID of review",
          "maxLength": 128
        },
        "rating": {
          "type": "number",
          "description": "Star rating 1-5"
        },
        "totalScore": {
          "type": "number",
          "description": "Combined rubric score 0-100"
        },
        "feedbackText": {
          "type": "string",
          "description": "Written review feedback",
          "maxLength": 5000
        },
        "aiQualityScore": {
          "type": "number",
          "description": "Constructive quality score"
        },
        "isBlindReview": {
          "type": "boolean",
          "description": "Blind peer review flag"
        },
        "upvotesCount": {
          "type": "number",
          "description": "Upvotes received"
        },
        "status": {
          "type": "string",
          "description": "Review status",
          "maxLength": 30
        },
        "createdAt": {
          "type": "string",
          "description": "Creation ISO timestamp",
          "maxLength": 40
        }
      },
      "required": ["id", "projectId", "reviewerId", "feedbackText"]
    },
    "Like": {
      "title": "Like",
      "description": "Project like record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique like ID (usually projectId_userId)",
          "maxLength": 128
        },
        "projectId": {
          "type": "string",
          "description": "Project ID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "User ID who liked",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp",
          "maxLength": 40
        }
      },
      "required": ["id", "projectId", "userId"]
    },
    "Message": {
      "title": "Message",
      "description": "Direct message between makers",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique message ID",
          "maxLength": 128
        },
        "senderId": {
          "type": "string",
          "description": "Sender user ID",
          "maxLength": 128
        },
        "recipientId": {
          "type": "string",
          "description": "Recipient user ID",
          "maxLength": 128
        },
        "text": {
          "type": "string",
          "description": "Message text",
          "maxLength": 2000
        },
        "timestamp": {
          "type": "string",
          "description": "Timestamp",
          "maxLength": 40
        },
        "isRead": {
          "type": "boolean",
          "description": "Read status"
        }
      },
      "required": ["id", "senderId", "recipientId", "text"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app notification for a user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Notification ID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Recipient user ID",
          "maxLength": 128
        },
        "type": {
          "type": "string",
          "description": "Notification type",
          "maxLength": 50
        },
        "title": {
          "type": "string",
          "description": "Title",
          "maxLength": 120
        },
        "message": {
          "type": "string",
          "description": "Message content",
          "maxLength": 500
        },
        "read": {
          "type": "boolean",
          "description": "Read flag"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp",
          "maxLength": 40
        }
      },
      "required": ["id", "userId", "type", "title", "message"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles for all accounts"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Project builds published or drafted"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Reviews on creator projects"
    },
    "/likes/{likeId}": {
      "schema": "Like",
      "description": "Liked projects by user"
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Direct communication between users"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notification alerts"
    }
  }
}
