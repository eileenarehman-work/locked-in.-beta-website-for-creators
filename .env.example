# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EMAIL_SERVICE_PROVIDER: Email provider to deliver real verification codes ('resend' or 'sendgrid').
EMAIL_SERVICE_PROVIDER="resend"

# RESEND_API_KEY: Required for sending real 6-digit email verification codes via Resend.
# Obtain your free API key at https://resend.com/api-keys
RESEND_API_KEY="re_123456789"

# SENDGRID_API_KEY: Optional alternative provider for SendGrid users.
# Obtain your API key at https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=""

# EMAIL_FROM: The verified sender email address.
# For Resend free accounts without custom domains, use "locked in. <onboarding@resend.dev>".
EMAIL_FROM="locked in. <onboarding@resend.dev>"
